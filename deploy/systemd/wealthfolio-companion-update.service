[Unit]
Description=Wealthfolio Companion - install a newer release when switched on (page Updates)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root, without a sandbox: it runs the same update as `update` in the console (packages, units, the service's
# key). It does nothing unless the page Updates switched it on; companion-autoupdate explains the steps.
User=root
# Like the console: the service user must read the program the update installs (0077 made it root-only).
UMask=0022
ExecStart=/usr/local/bin/companion-autoupdate
# The install engine calls `clear`, which fails without a terminal type - as a service there is none.
Environment=TERM=xterm
TimeoutStartSec=30min
