[Unit]
Description=Wealthfolio Companion - certificate of the web UI for the current name and addresses
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Root: it writes /etc/wealthfolio-companion/tls (root only) and restarts the web UI when the certificate changed.
User=root
ExecStart=/opt/wealthfolio-companion/venv/bin/wealthfolio-companion renew-cert
Environment=COMPANION_DATA=/opt/wealthfolio-companion/data
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/wealthfolio-companion/tls
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RemoveIPC=true
ProtectProc=invisible
CapabilityBoundingSet=
# Netlink for the addresses (hostname -I), AF_UNIX for systemctl; it sends no IP traffic at all. (Inside an
# unprivileged LXC systemd may lack BPF firewalling: it warns and starts the unit without the IP filter.)
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
IPAddressDeny=any
