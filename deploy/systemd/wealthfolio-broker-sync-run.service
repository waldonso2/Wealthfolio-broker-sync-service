[Unit]
Description=Wealthfolio Broker Sync (scheduled sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=brokersync
Group=brokersync
Environment=BROKERSYNC_DATA=/opt/wealthfolio-broker-sync/data
Environment=BROKERSYNC_RUNTIME=/run/wealthfolio-broker-sync
# The service's key: drop-in 10-key.conf from deploy/setup.sh.
ExecStart=/opt/wealthfolio-broker-sync/venv/bin/brokersync run
# A broker that hangs must not block every later run (#107): stopped after 45 minutes, the run is
# marked as aborted when the next one starts (State.abort_stale_runs).
TimeoutStartSec=45min
RuntimeDirectory=wealthfolio-broker-sync
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
# #107: only the system calls of an ordinary service (no mount, reboot, module, swap, clock ...); a
# refused one fails with EPERM instead of killing the process. Hidden: other users' processes, and no
# System V IPC left behind.
SystemCallFilter=@system-service
# Landlock for Scalable's sc (brokersync.sandbox, #93).
SystemCallFilter=@sandbox
SystemCallErrorNumber=EPERM
ProtectProc=invisible
RemoveIPC=true
DevicePolicy=closed
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/opt/wealthfolio-broker-sync/data
