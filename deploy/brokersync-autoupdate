#!/usr/bin/env bash
# The container's updater (wealthfolio-broker-sync-update.timer, root, every minute). Switched on and timed on
# the page Updates: it asks the service (brokersync-cli update-due) whether GitHub is due and whether a newer
# release is out, then runs the same update as `update` in the console - unattended (PHS_SILENT=1), with its
# check of every file against the release's SHA256SUMS - and reports how it went (brokersync-cli update-done).
set -euo pipefail

STATE=/var/lib/wealthfolio-broker-sync-update
BIN=/opt/wealthfolio-broker-sync/venv/bin/brokersync
RETRY=3600 # a version that failed is tried again after an hour, not every minute
install -d -m 700 "$STATE"
now="$(date +%s)"

# A fetch going on keeps its files: the update replaces the program under it.
systemctl is-active --quiet wealthfolio-broker-sync-run.service && exit 0

last="$(cat "$STATE/checked" 2>/dev/null || echo 0)"
answer="$(/usr/local/bin/brokersync-cli update-due --since "$((now - last))")" || exit 0
grep -qx checked <<<"$answer" || exit 0
echo "$now" >"$STATE/checked"
version="$(sed -n 's/^install \([0-9][0-9.]*\)$/\1/p' <<<"$answer")"
[[ -n "$version" ]] || exit 0

if [[ "$(cat "$STATE/failed" 2>/dev/null)" == "$version" ]] &&
  ((now - $(stat -c %Y "$STATE/failed") < RETRY)); then
  exit 0
fi

old="$("$BIN" --version)"
echo "Installing version $version (installed: $old)"
if PHS_SILENT=1 /usr/bin/update && [[ "$("$BIN" --version)" == "$version" ]]; then
  rm -f "$STATE/failed"
  /usr/local/bin/brokersync-cli update-done --from "$old" --to "$version"
else
  echo "$version" >"$STATE/failed"
  /usr/local/bin/brokersync-cli update-done --from "$old" --to "$version" --failed || true
  exit 1
fi
